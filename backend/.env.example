# SQLite database file (default: data/app.sqlite)
DATABASE_PATH=

# Server
PORT=3000
SERVER_ORIGIN=http://localhost:3000

# Production: set NODE_ENV=production on Render
# Session (required in production)
SESSION_SECRET=
# Exact Vercel URL, no trailing slash (required for CORS + cookies)
FRONTEND_ORIGIN=http://localhost:5173

# CoinGecko Pro API key (optional — leave empty for the free public API)
COINGECKO_API_KEY=
COINGECKO_BASE_URL=

# OpenRouter API key for daily insights
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini